# Copy to .env for local development. .env is gitignored.
# In production the key is stored in the OS keychain via the operator UI instead.

# Gemini API key with access to the Live Translate model.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults are baked into the app; set these only to experiment).
# GEMINI_MODEL=gemini-3.5-live-translate-preview
# GEMINI_WS_HOST=generativelanguage.googleapis.com
