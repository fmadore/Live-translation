# Copy to .env for local development. .env is gitignored.
# In production the key is stored in the OS keychain via the operator UI instead.

# Gemini API key with access to the Live Translate model.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI API key with access to gpt-realtime-translate (only needed for the OpenAI provider).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides (defaults are baked in; set only to experiment / pin a version).
# Used by the "Live Translate" engine (dedicated speech-to-speech model):
# GEMINI_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
# Used by the "Speech → Text" engine (general Live model, audio in / text out):
# GEMINI_STT_MODEL=gemini-3.1-flash-live-preview
# GEMINI_WS_HOST=generativelanguage.googleapis.com

# OpenAI provider overrides:
# OPENAI_TRANSLATE_MODEL=gpt-realtime-translate
# OPENAI_TRANSCRIBE_MODEL=gpt-realtime-whisper
# OPENAI_WS_HOST=api.openai.com
