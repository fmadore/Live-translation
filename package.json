{
	"name": "live-translation",
	"version": "1.1.0",
	"description": "Real-time speech translation and same-language subtitles with a transparent caption overlay for hybrid rooms and events",
	"license": "MIT",
	"author": "Frédérick Madore (https://orcid.org/0000-0003-0959-2092)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fmadore/Live-translation.git"
	},
	"bugs": "https://github.com/fmadore/Live-translation/issues",
	"homepage": "https://github.com/fmadore/Live-translation#readme",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.12.0 || ^24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"bundle:msix:x64": "tauri-windows-bundle build --arch x64 --runner npm",
		"bundle:msix:arm64": "tauri-windows-bundle build --arch arm64 --runner npm",
		"tauri": "tauri",
		"generate:rehearsal-fixtures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-rehearsal-fixtures.ps1"
	},
	"devDependencies": {
		"@choochmeque/tauri-windows-bundle": "^0.1.28",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.19.21",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@fontsource/archivo": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@tauri-apps/api": "^2.11.1"
	}
}
