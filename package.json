{
	"name": "live-translation",
	"version": "1.11.0",
	"description": "Offline Whisper captions and cloud translation in a transparent Windows overlay for meetings, calls and presentations",
	"license": "MIT",
	"author": "Frédérick Madore (https://orcid.org/0000-0003-0959-2092)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fmadore/Live-translation.git"
	},
	"bugs": "https://github.com/fmadore/Live-translation/issues",
	"homepage": "https://github.com/fmadore/Live-translation#readme",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"prepare": "svelte-kit sync || echo ''",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p e2e",
		"lint": "eslint .",
		"knip": "knip",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:style": "playwright test -c e2e/style.config.ts",
		"test:e2e": "playwright test -c e2e/native.config.ts",
		"bundle:msix:x64": "tauri-windows-bundle build --arch x64 --runner npm",
		"bundle:msix:arm64": "tauri-windows-bundle build --arch arm64 --runner npm",
		"tauri": "tauri",
		"generate:rehearsal-fixtures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-rehearsal-fixtures.ps1",
		"generate:languages": "node scripts/generate-languages.mjs",
		"check:languages": "node scripts/generate-languages.mjs --check"
	},
	"devDependencies": {
		"@choochmeque/tauri-windows-bundle": "^0.2.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"jsdom": "^30.1.3",
		"knip": "^6.42.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@fontsource/archivo": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@tauri-apps/api": "^2.12.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
