<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The direct (not sandboxed) Mac build, signed with the hardened runtime: the one exception it
     needs is the microphone, which the hardened runtime otherwise blocks without asking.
     System audio through a Core Audio tap needs no entitlement, only its Info.plist description. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
